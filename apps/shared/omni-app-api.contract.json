{
  "name": "Omni Tri-App Sync API",
  "version": "1.12.7+root-monorepo-production-ga-candidate",
  "contract_version": "1.0",
  "contract_version_policy": "MAJOR.MINOR. Clients send X-OmniDesk-Contract with the version they were built for, and the gateway answers every contract route with its own. A minor version only adds routes or optional fields, so a client of the same major is served. A client of another major is refused with 426 contract_version_unsupported, and a client refuses a gateway of another major. A request without the header (a client from before negotiation) is served. Response schemas list what clients rely on; a gateway may send more fields.",
  "auth": {
    "type": "bearer",
    "roles": [
      "viewer",
      "operator",
      "owner"
    ],
    "headers": [
      "Authorization: Bearer <token>",
      "X-OmniDesk-Actor: <actor>",
      "Idempotency-Key: <operation-key>",
      "Last-Event-ID: <monotonic-event-id>",
      "X-OmniDesk-Device-Id: <device-id>",
      "X-OmniDesk-Timestamp: <unix-ms>",
      "X-OmniDesk-Nonce: <random-nonce>",
      "X-OmniDesk-Device-Signature: <base64-signature>",
      "X-OmniDesk-Contract: <major.minor>",
      "X-OmniDesk-Approval-Timestamp: <unix-ms>",
      "X-OmniDesk-Approval-Nonce: <random-nonce>",
      "X-OmniDesk-Approval-Signature: <base64-ed25519-signature>",
      "X-OmniDesk-Client-Role: <role> (Web Admin server only)",
      "X-OmniDesk-Client-IP: <address> (Web Admin server only)"
    ],
    "device_signature": "For enrolled desktop/mobile/web_admin devices, production sensitive requests must sign: method, path, SHA-256 body hash, timestamp, and nonce. Nonces are one-use replay guards.",
    "websocket": "Authorization header preferred; query token remains development-only compatibility mode"
  },
  "surfaces": [
    "desktop",
    "mobile",
    "web_admin"
  ],
  "client_surface_policy": "Each endpoint declares client_surfaces. Typed client contract tests are generated from this field; endpoints with an empty list are server/API-only and must not be required by tri-app clients.",
  "schemas": {
    "Project": {
      "type": "object",
      "properties": {
        "description": {"type": ["string", "null"]},
        "owner_actor": {"type": ["string", "null"]},
        "organization_id": {"type": "string"},
        "metadata": {"type": "object"},
        "created_at": {"type": "number"},
        "updated_at": {"type": "number"},
        "project_id": {"type": "string"},
        "name": {"type": "string"},
        "archived": {"type": "boolean"}
      },
      "required": ["project_id", "name", "archived"]
    },
    "PendingApproval": {
      "type": "object",
      "properties": {
        "reason": {"type": ["string", "null"]},
        "expires_at": {"type": ["number", "null"]},
        "action_detail": {"type": "object"},
        "action_hash": {"type": ["string", "null"]},
        "approval_id": {"type": "string"},
        "action": {"type": "string"},
        "risk": {"type": "string"}
      },
      "required": ["approval_id", "action", "risk"]
    },
    "Notification": {
      "type": "object",
      "properties": {
        "notification_id": {"type": "string"},
        "title": {"type": "string"},
        "body": {"type": "string"}
      },
      "required": ["notification_id", "title", "body"]
    },
    "Message": {
      "type": "object",
      "properties": {
        "model_provider": {"type": ["string", "null"]},
        "model_name": {"type": ["string", "null"]},
        "model_profile": {"type": ["string", "null"]},
        "trace_id": {"type": ["string", "null"]},
        "role": {"type": "string"},
        "content": {"type": "string"}
      },
      "required": ["role", "content"]
    },
    "ClaimedTask": {
      "type": "object",
      "properties": {
        "approval_id": {"type": ["string", "null"]},
        "capability": {"type": ["string", "null"]},
        "action_hash": {"type": ["string", "null"]},
        "task_id": {"type": "string"},
        "title": {"type": "string"},
        "action": {"type": "object"}
      },
      "required": ["task_id", "title", "action"]
    },
    "Device": {
      "type": "object",
      "properties": {
        "device_id": {"type": "string"},
        "device_type": {"type": "string"},
        "credential_status": {"type": "string"},
        "name": {"type": "string"},
        "trust_level": {"type": ["string", "null"]},
        "revoked_at": {"type": ["number", "null"]}
      },
      "required": ["device_id", "device_type", "credential_status"]
    },
    "SyncEvent": {
      "type": "object",
      "properties": {
        "seq": {"type": "integer"},
        "event_type": {"type": "string"},
        "actor": {"type": "string"},
        "ts": {"type": "number"},
        "payload": {"type": "object"}
      },
      "required": ["seq", "event_type", "actor", "ts"]
    },
    "TaskAction": {
      "type": "object",
      "properties": {
        "capability": {"type": "string"},
        "scope": {
          "type": "object",
          "properties": {
            "workspace": {"type": "string"},
            "relative_path": {"type": "string"}
          },
          "required": ["relative_path"]
        }
      },
      "required": ["capability", "scope"]
    }
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/app/bootstrap",
      "role": "viewer",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "pending_approvals": {
            "type": "array",
            "items": {"$ref": "#/schemas/PendingApproval"}
          },
          "notifications": {
            "type": "array",
            "items": {"$ref": "#/schemas/Notification"}
          },
          "runtime_status": {"type": "array"},
          "devices": {
            "type": "array",
            "items": {"$ref": "#/schemas/Device"}
          },
          "sync_seq": {"type": "integer"}
        },
        "required": ["pending_approvals", "notifications", "runtime_status", "devices", "sync_seq"]
      }
    },
    {
      "method": "GET",
      "path": "/app/projects",
      "description": "List user-created projects in the caller organization for Web Admin, Desktop, and Mobile project synchronization.",
      "role": "viewer",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {"$ref": "#/schemas/Project"}
          }
        },
        "required": ["projects"]
      }
    },
    {
      "method": "POST",
      "path": "/app/projects",
      "description": "Create a user-owned project and emit a project.created sync event. No default projects are provisioned by the Gateway.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "description": {"type": "string"},
          "metadata": {"type": "object"},
          "source_device_id": {"type": "string"},
          "source": {"type": "string"},
          "name": {"type": "string"}
        },
        "required": ["name"]
      },
      "response": {
        "type": "object",
        "properties": {
          "project": {"$ref": "#/schemas/Project"}
        },
        "required": ["project"]
      }
    },
    {
      "method": "PATCH",
      "path": "/app/projects/{project_id}",
      "description": "Rename or update metadata for a user-created project within the caller organization.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "archived": {"type": "boolean"},
          "description": {"type": "string"},
          "metadata": {"type": "object"}
        }
      },
      "response": {"type": "object"}
    },
    {
      "method": "DELETE",
      "path": "/app/projects/{project_id}",
      "description": "Soft-delete a user-created project and emit a project.deleted sync event.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "response": {"type": "object"}
    },
    {
      "method": "POST",
      "path": "/app/devices/register",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "platform": {"type": "string"},
          "public_key": {"type": ["string", "null"]},
          "capabilities": {
            "type": "array",
            "items": {"type": "string"}
          },
          "organization_id": {"type": "string"},
          "push_token": {"type": ["string", "null"]},
          "push_token_type": {"type": "string"},
          "device_id": {"type": "string"},
          "device_type": {"type": "string"}
        },
        "required": ["device_id", "device_type"]
      },
      "response": {
        "type": "object",
        "properties": {
          "device": {
            "type": "object",
            "properties": {
              "device_id": {"type": "string"},
              "credential_status": {"type": "string"}
            },
            "required": ["device_id", "credential_status"]
          }
        },
        "required": ["device"]
      }
    },
    {
      "method": "GET",
      "path": "/app/conversations",
      "role": "viewer",
      "client_surfaces": ["web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "conversations": {"type": "array"}
        },
        "required": ["conversations"]
      }
    },
    {
      "method": "POST",
      "path": "/app/conversations",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "source_device_id": {"type": "string"}
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "object",
            "properties": {
              "conversation_id": {"type": "string"}
            },
            "required": ["conversation_id"]
          }
        },
        "required": ["conversation"]
      }
    },
    {
      "method": "DELETE",
      "path": "/app/conversations/{conversation_id}",
      "role": "operator",
      "description": "Erase one of the caller's conversations, its messages, chat replays, notifications, pushes, idempotency responses and offline-sync payloads; sync events lose the title. Tasks and approvals stay as the organization's record.",
      "client_surfaces": []
    },
    {
      "method": "POST",
      "path": "/app/conversations/{conversation_id}/messages",
      "role": "operator",
      "client_surfaces": ["mobile"],
      "request": {
        "type": "object",
        "properties": {
          "requires_desktop_runtime": {"type": "boolean"},
          "risk": {"type": "string"},
          "action": {"$ref": "#/schemas/TaskAction"},
          "content": {"type": "string"}
        },
        "required": ["content"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "GET",
      "path": "/app/conversations/{conversation_id}/messages",
      "role": "viewer",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {"$ref": "#/schemas/Message"}
          }
        },
        "required": ["messages"]
      }
    },
    {
      "method": "POST",
      "path": "/app/conversations/{conversation_id}/ask",
      "description": "Create a Gateway-audited non-streaming chat turn and persist model metadata without exposing provider credentials.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "model_profile": {"type": "string"},
          "stream": {"type": "boolean"},
          "source_device_id": {"type": "string"},
          "content": {"type": "string"}
        },
        "required": ["content"]
      },
      "response": {
        "type": "object",
        "properties": {
          "user_message": {"$ref": "#/schemas/Message"},
          "audit_trace_id": {"type": ["string", "null"]},
          "assistant_message": {"$ref": "#/schemas/Message"}
        },
        "required": ["assistant_message"]
      }
    },
    {
      "method": "POST",
      "path": "/api/chat",
      "description": "Unified non-streaming fallback entrypoint for Web, Desktop, Mobile, and API clients.",
      "role": "operator",
      "client_surfaces": []
    },
    {
      "method": "POST",
      "path": "/api/chat/stream",
      "description": "Governed provider-native SSE chat with monotonic event IDs, heartbeat, cancellation, Last-Event-ID replay, bounded concurrency, complete-response persistence, usage/cost/audit binding, and explicit completion/failure events. Clients may fall back to the non-streaming conversation endpoint only before receiving the first stream event.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "stream_events": [
        "chat.started",
        "chat.delta",
        "chat.reasoning.delta",
        "chat.usage",
        "chat.completed",
        "chat.failed"
      ],
      "supports_cancellation": true,
      "supports_resume": true,
      "fallback_endpoint": "/app/conversations/{conversation_id}/ask",
      "request": {
        "type": "object",
        "properties": {
          "conversation_id": {"type": "string"},
          "model_profile": {"type": "string"},
          "source_device_id": {"type": "string"},
          "content": {"type": "string"}
        },
        "required": ["content"]
      },
      "response_content_type": "text/event-stream"
    },
    {
      "method": "GET",
      "path": "/app/tasks/{task_id}",
      "role": "viewer",
      "client_surfaces": []
    },
    {
      "method": "POST",
      "path": "/app/tasks/{task_id}/status",
      "role": "operator",
      "client_surfaces": ["desktop"],
      "signed_device_required_in_production": ["desktop"],
      "request": {
        "type": "object",
        "properties": {
          "result_summary": {"type": "string"},
          "assigned_runtime_device_id": {"type": "string"},
          "result": {"type": "object"},
          "status": {"type": "string"}
        },
        "required": ["status"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "GET",
      "path": "/app/approvals",
      "role": "viewer",
      "client_surfaces": ["web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "approvals": {"type": "array"}
        },
        "required": ["approvals"]
      }
    },
    {
      "method": "POST",
      "path": "/app/approvals/{approval_id}/decide",
      "role": "owner",
      "client_surfaces": ["mobile", "web_admin"],
      "signed_device_required_in_production": ["mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "reason": {"type": ["string", "null"]},
          "source_device_id": {"type": ["string", "null"]},
          "decision": {"type": "string"}
        },
        "required": ["decision"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "GET",
      "path": "/app/notifications",
      "role": "viewer",
      "client_surfaces": ["mobile", "web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "notifications": {
            "type": "array",
            "items": {"$ref": "#/schemas/Notification"}
          }
        },
        "required": ["notifications"]
      }
    },
    {
      "method": "POST",
      "path": "/app/runtime/desktop/heartbeat",
      "role": "operator",
      "client_surfaces": ["desktop"],
      "signed_device_required_in_production": ["desktop"],
      "request": {
        "type": "object",
        "properties": {
          "version": {"type": "string"},
          "active_task_id": {"type": "string"},
          "capabilities": {
            "type": "array",
            "items": {"type": "string"}
          },
          "device_id": {"type": "string"},
          "status": {"type": "string"}
        },
        "required": ["device_id", "status"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "POST",
      "path": "/app/runtime/desktop/claim",
      "role": "operator",
      "client_surfaces": ["desktop"],
      "signed_device_required_in_production": ["desktop"],
      "request": {
        "type": "object",
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {"type": "string"}
          },
          "lease_seconds": {"type": "integer"},
          "device_id": {"type": "string"}
        },
        "required": ["device_id"]
      },
      "response": {
        "type": "object",
        "properties": {
          "task": {
            "anyOf": [
              {"$ref": "#/schemas/ClaimedTask"},
              {"type": "null"}
            ]
          }
        },
        "required": ["task"]
      }
    },
    {
      "method": "GET",
      "path": "/app/sync",
      "role": "viewer",
      "client_surfaces": ["desktop", "web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {"$ref": "#/schemas/SyncEvent"}
          },
          "head_seq": {"type": "integer"},
          "has_more": {"type": "boolean"}
        },
        "required": ["events", "head_seq", "has_more"]
      }
    },
    {
      "method": "POST",
      "path": "/app/sync",
      "role": "operator",
      "client_surfaces": []
    },
    {
      "method": "GET",
      "path": "/app/sync/state",
      "role": "viewer",
      "client_surfaces": []
    },
    {
      "method": "GET",
      "path": "/app/sync/conflicts",
      "role": "viewer",
      "description": "The caller's own offline-sync conflicts (status open or resolved).",
      "client_surfaces": []
    },
    {
      "method": "POST",
      "path": "/app/sync/conflicts/{conflict_id}/resolve",
      "role": "operator",
      "description": "Resolve one of the caller's open conflicts with keep_server, apply_client or merged (with payload).",
      "client_surfaces": []
    },
    {
      "method": "WS",
      "path": "/app/ws",
      "role": "gateway-protected",
      "client_surfaces": []
    },
    {
      "method": "POST",
      "path": "/app/devices/{device_id}/push-token",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile"],
      "signed_device_required_in_production": ["desktop", "mobile"],
      "request": {
        "type": "object",
        "properties": {
          "token_type": {"type": "string"},
          "platform": {"type": "string"},
          "push_token": {"type": "string"}
        },
        "required": ["push_token"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "POST",
      "path": "/app/devices/{device_id}/approval-key",
      "description": "Register the device's biometric/passcode-gated Ed25519 approval key (write-once); decisions from that device then require its signature.",
      "role": "operator",
      "client_surfaces": ["mobile"],
      "signed_device_required_in_production": ["mobile"],
      "request": {
        "type": "object",
        "properties": {
          "public_key": {"type": "string"}
        },
        "required": ["public_key"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "POST",
      "path": "/app/devices/enrollment/start",
      "role": "owner",
      "client_surfaces": ["mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "device_type": {"type": "string"},
          "pairing_code": {"type": "string"}
        },
        "required": ["device_type", "pairing_code"]
      },
      "response": {
        "type": "object",
        "properties": {
          "enrollment": {
            "type": "object",
            "properties": {
              "enrollment_id": {"type": "string"}
            },
            "required": ["enrollment_id"]
          }
        },
        "required": ["enrollment"]
      }
    },
    {
      "method": "POST",
      "path": "/app/devices/enrollment/{enrollment_id}/complete",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "pairing_code": {"type": "string"},
          "device_id": {"type": "string"},
          "public_key": {"type": "string"}
        },
        "required": ["pairing_code", "device_id", "public_key"]
      },
      "response": {"type": "object"}
    },
    {
      "method": "POST",
      "path": "/app/devices/enrollment/{enrollment_id}/challenge",
      "description": "Issue a nonce challenge for device credential verification.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "device_id": {"type": "string"}
        },
        "required": ["device_id"]
      },
      "response": {
        "type": "object",
        "properties": {
          "challenge": {
            "type": "object",
            "properties": {
              "challenge_id": {"type": "string"},
              "signing_message": {"type": "string"}
            },
            "required": ["challenge_id", "signing_message"]
          }
        },
        "required": ["challenge"]
      }
    },
    {
      "method": "POST",
      "path": "/app/devices/enrollment/{enrollment_id}/verify",
      "description": "Verify a signed device challenge and mint a device credential.",
      "role": "operator",
      "client_surfaces": ["desktop", "mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "challenge_id": {"type": "string"},
          "device_id": {"type": "string"},
          "signature": {"type": "string"}
        },
        "required": ["challenge_id", "device_id", "signature"]
      },
      "response": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "object",
            "properties": {
              "trust_level": {"type": "string"}
            },
            "required": ["trust_level"]
          }
        },
        "required": ["credential"]
      }
    },
    {
      "method": "POST",
      "path": "/app/devices/{device_id}/rotate-token",
      "description": "Rotate a device token hash after successful device authentication.",
      "role": "operator",
      "client_surfaces": [],
      "signed_device_required_in_production": ["desktop", "mobile", "web_admin"]
    },
    {
      "method": "POST",
      "path": "/app/devices/{device_id}/revoke",
      "description": "Revoke a desktop/mobile/web_admin device credential.",
      "role": "owner",
      "client_surfaces": ["web_admin"],
      "signed_device_required_in_production": ["mobile", "web_admin"],
      "request": {
        "type": "object",
        "properties": {
          "reason": {"type": "string"}
        }
      },
      "response": {
        "type": "object",
        "properties": {
          "device": {"$ref": "#/schemas/Device"}
        },
        "required": ["device"]
      }
    },
    {
      "method": "GET",
      "path": "/admin/session/identity",
      "description": "The actor and role the presented bearer token authenticates; Web Admin binds its session to them at login.",
      "role": "viewer",
      "client_surfaces": ["web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "actor": {"type": "string"},
          "role": {"type": "string"}
        },
        "required": ["actor", "role"]
      }
    },
    {
      "method": "GET",
      "path": "/admin/channels/ecosystem",
      "description": "Channel ecosystem matrix: supported channels, their capabilities and security posture.",
      "role": "viewer",
      "client_surfaces": ["web_admin"],
      "response": {
        "type": "object",
        "properties": {
          "channels": {"type": "array"}
        },
        "required": ["channels"]
      }
    },
    {
      "method": "POST",
      "path": "/app/push/dispatch",
      "description": "Send due push outbox items now through the configured provider; the gateway also dispatches automatically when a real provider is configured.",
      "role": "owner",
      "client_surfaces": []
    }
  ],
  "shared_objects": [
