[Unit]
Description=Create a verified, encrypted OmniDesk PostgreSQL backup set
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=omnidesk
Group=omnidesk
# OMNIDESK_POSTGRES_DSN, OMNIDESK_APPSYNC_POSTGRES_DSN and OMNIDESK_BACKUP_ENCRYPTION_KEY.
EnvironmentFile=-/etc/omnidesk/backup.env
# Backups hold personal data: pruned after 30 days, never more than 35 (SECURITY.md,
# tests/test_backup_retention_policy.py). The script verifies the new set before it succeeds.
ExecStart=/opt/omnidesk/venv/bin/python /opt/omnidesk/scripts/backup_postgres.py --dest /var/backups/omnidesk/postgres --encrypt --retention-days 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/omnidesk
