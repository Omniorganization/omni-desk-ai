<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.omnidesk.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <!-- Logs go to the user's own Library/Logs: a shared /tmp path can be
         pre-created or symlinked by another local user. -->
    <string>umask 077; mkdir -p "$HOME/Library/Logs/omnidesk" &amp;&amp; exec /usr/local/bin/omnidesk --config "$HOME/.omnidesk/config.yaml" serve &gt;&gt;"$HOME/Library/Logs/omnidesk/agent.out.log" 2&gt;&gt;"$HOME/Library/Logs/omnidesk/agent.err.log"</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
