# MONICO BFF route contract only; methods, roles and device signatures remain enforced by Gateway.
server {
    listen 443 ssl;
    server_name @HOST@;
    ssl_certificate @CERT@;
    ssl_certificate_key @KEY@;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_body_timeout 15s;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Quote the bounded ID regex for nginx; no URI component on proxy_pass preserves signed paths.
    location ~ "^/(admin/session/identity|api/chat/stream|app/(bootstrap|projects(/[A-Za-z0-9_-]{1,160})?|conversations(/[A-Za-z0-9_-]{1,160}/(messages|ask))?|approvals(/[A-Za-z0-9_-]{1,160}/decide)?|notifications|devices/(register|enrollment/(start|[A-Za-z0-9_-]{1,160}/(complete|challenge|verify)))|tasks/[A-Za-z0-9_-]{1,160}))$" {
        proxy_pass http://127.0.0.1:18789;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host @AUTHORITY@;
        proxy_set_header X-Forwarded-Host @AUTHORITY@;
        proxy_set_header X-Forwarded-Proto https;
        # Uvicorn trusts loopback proxy headers. Keep AdminAuth's socket-client allowlist intact;
        # nginx access logs retain the actual peer; backend IP quotas remain conservatively shared.
        proxy_set_header X-Forwarded-For "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
    }
    location / { return 404; }
}
