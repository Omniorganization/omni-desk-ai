        "uid": "omnidesk-prometheus"
      }
    },
    {
      "title": "HTTP p95 latency by route",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(omnidesk_http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{path}}",
          "datasource": {
            "type": "prometheus",
            "uid": "omnidesk-prometheus"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "omnidesk-prometheus"
      }
    },
    {
      "title": "Span p95 latency (tool.call, planner.plan, ...)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, span) (rate(omnidesk_span_duration_seconds_bucket[5m])))",
