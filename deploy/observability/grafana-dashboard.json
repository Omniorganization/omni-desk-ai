{
  "panels": [
    {
      "title": "Gateway targets up",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(up{job=\"omnidesk-agent\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "omnidesk-prometheus"
          }
        }
      ],
      "id": 1,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "omnidesk-prometheus"
      }
    },
    {
      "title": "API 5xx ratio (5m / 1h, SLO 0.5%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "omnidesk:api_error_ratio:rate5m",
          "refId": "A",
          "legendFormat": "5m",
          "datasource": {
            "type": "prometheus",
            "uid": "omnidesk-prometheus"
          }
        },
        {
          "expr": "omnidesk:api_error_ratio:rate1h",
          "refId": "B",
          "legendFormat": "1h",
          "datasource": {
            "type": "prometheus",
            "uid": "omnidesk-prometheus"
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "omnidesk-prometheus"
      }
    },
    {
      "title": "Control-plane requests over 1s (SLO 1%)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "omnidesk:api_slow_ratio:rate5m",
          "refId": "A",
          "legendFormat": "5m",
          "datasource": {
            "type": "prometheus",
            "uid": "omnidesk-prometheus"
          }
        }
      ],
      "id": 3,
      "gridPos": {
